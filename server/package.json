{
  "name": "game server",
  "version": "1.0.0",
  "description": "headless game server for auth and physics sync",
  "main": "src/index.ts",
  "scripts": {
    "client": "cd ../client && npm run dev",
    "server": "nodemon --exec tsx src/index.ts | pino-pretty",
    "both": "concurrently -k -c \"magenta,cyan\" \"npm run server\" \"npm run client\"",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
